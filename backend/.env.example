PORT=5000
MONGODB_URI=
LOGO_MODEL=
POLLINATIONS_API_KEY=
HUGGINGFACE_MODEL=

# SECURITY FIX: JWT Secret - REQUIRED (min 32 characters)
# Generate with: openssl rand -base64 64
JWT_SECRET=

# Set your API keys here
CLAID_API_KEY=
GROQ_API_KEY=
GOOGLEMAP_API_KEY=

# SECURITY FIX: Webhook Secrets - NEVER hardcode in code
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# SECURITY FIX: Payment Gateway Configuration
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_WEBHOOK_SECRET=

# Instagram API (for n8n automation - platform level)
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=

# Instagram OAuth (for user-connected accounts - requires Meta for Developers app)
# Get these from https://developers.facebook.com/
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# Security & Deployment
NODE_ENV=production
GIN_MODE=release

# Optional: Override seed password for development (min 8 chars)
# SEED_PASSWORD=devpassword123
