{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --profile preview",
    "check:release": "node ./scripts/validate-release-config.js",
    "build:android:production": "npm run check:release && eas build --platform android --profile production",
    "lint": "eslint src/ --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,json}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "axios": "^1.13.5",
    "expo": "^56.0.0",
    "expo-build-properties": "~56.0.0",
    "expo-camera": "~56.0.0",
    "expo-device": "~56.0.0",
    "expo-file-system": "~56.0.0",
    "expo-font": "~56.0.0",
    "expo-image-picker": "~56.0.0",
    "expo-linking": "~56.0.0",
    "expo-location": "~56.0.0",
    "expo-notifications": "~56.0.0",
    "expo-secure-store": "~56.0.0",
    "expo-speech": "^56.0.0",
    "expo-sqlite": "~56.0.0",
    "expo-status-bar": "~56.0.0",
    "expo-web-browser": "~56.0.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-webview": "13.16.1",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "eas-cli": "^18.0.1"
  },
  "private": true
}
